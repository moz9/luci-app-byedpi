#!/bin/sh

HELPER_NAME="byedpi-luci"
DATA_DIR="/usr/share/byedpi-luci"
STRATEGIES_FILE="$DATA_DIR/strategies.txt"
DOMAINS_FILE="$DATA_DIR/domains.txt"

. /usr/share/libubox/jshn.sh

clean_lines() {
	local file="$1"
	[ -f "$file" ] || return 0
	sed -e 's/#.*$//' -e 's,//.*$,,' "$file" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$'
}

json_status() {
	local running=0 pid="" command="" enabled=0 current="" tmp_command part

	current="$(uci -q get byedpi.main.cmd_opts || true)"
	[ -n "$current" ] || current="$(uci -q get byedpi.main.options || true)"
	/etc/init.d/byedpi enabled >/dev/null 2>&1 && enabled=1

	if ubus call service list '{"name":"byedpi"}' >/tmp/byedpi-luci-service.json 2>/dev/null; then
		running="$(jsonfilter -i /tmp/byedpi-luci-service.json -e '@.byedpi.instances.instance1.running' 2>/dev/null || echo 0)"
		pid="$(jsonfilter -i /tmp/byedpi-luci-service.json -e '@.byedpi.instances.instance1.pid' 2>/dev/null || true)"
		command="$(jsonfilter -i /tmp/byedpi-luci-service.json -e '@.byedpi.instances.instance1.command' 2>/dev/null || true)"
	fi

	[ "$running" = "true" ] && running=1

	tmp_command="$(mktemp)"
	if [ -n "$command" ]; then
		echo "$command" | jsonfilter -e '@[*]' > "$tmp_command" 2>/dev/null || true
	fi

	json_init
	json_add_boolean running "$running"
	json_add_boolean enabled "$enabled"
	json_add_string pid "$pid"
	json_add_string current_strategy "$current"
	json_add_array command
	while IFS= read -r part; do
		json_add_string "" "$part"
	done < "$tmp_command"
	json_close_array
	json_dump

	rm -f "$tmp_command"
}

list_strategies() {
	local index=0 line score tmp_strategies

	tmp_strategies="$(mktemp)"
	clean_lines "$STRATEGIES_FILE" > "$tmp_strategies"

	json_init
	json_add_array strategies
	while IFS= read -r line; do
		index=$((index + 1))
		score=""
		json_add_object
		json_add_int id "$index"
		json_add_string value "$line"
		json_add_string score "$score"
		json_close_object
	done < "$tmp_strategies"
	json_close_array
	json_dump

	rm -f "$tmp_strategies"
}

add_check() {
	local name="$1" ok="$2" detail="$3"

	json_add_object
	json_add_string name "$name"
	json_add_boolean ok "$ok"
	json_add_string detail "$detail"
	json_close_object
}

diagnostics() {
	local detail ok port_line proxy_detail podkop_proxy podkop_resolve current

	current="$(uci -q get byedpi.main.cmd_opts || true)"
	[ -n "$current" ] || current="$(uci -q get byedpi.main.options || true)"

	json_init
	json_add_string current_strategy "$current"
	json_add_array checks

	if [ -x /usr/bin/ciadpi ]; then
		detail="$(/usr/bin/ciadpi --help 2>&1 | head -n 1)"
		add_check "ciadpi" 1 "${detail:-/usr/bin/ciadpi найден}"
	else
		add_check "ciadpi" 0 "/usr/bin/ciadpi не найден или не исполняемый"
	fi

	if [ -x /etc/init.d/byedpi ]; then
		add_check "init-скрипт" 1 "/etc/init.d/byedpi"
	else
		add_check "init-скрипт" 0 "/etc/init.d/byedpi не найден"
	fi

	if uci -q get byedpi.main >/dev/null; then
		add_check "UCI config" 1 "/etc/config/byedpi, секция main"
	else
		add_check "UCI config" 0 "Нет секции byedpi.main"
	fi

	if /etc/init.d/byedpi enabled >/dev/null 2>&1; then
		add_check "Автозапуск" 1 "enabled"
	else
		add_check "Автозапуск" 0 "disabled"
	fi

	if /etc/init.d/byedpi status >/dev/null 2>&1; then
		add_check "Сервис" 1 "running"
	else
		add_check "Сервис" 0 "not running"
	fi

	port_line="$(netstat -tulnp 2>/dev/null | grep ':1080 ' | head -n 1)"
	if [ -n "$port_line" ]; then
		add_check "SOCKS 127.0.0.1:1080" 1 "$port_line"
	else
		add_check "SOCKS 127.0.0.1:1080" 0 "Порт 1080 не слушается"
	fi

	if curl --socks5-hostname 127.0.0.1:1080 --connect-timeout 3 -m 8 --fail -L -o /dev/null https://ya.ru >/tmp/byedpi-luci-curl.log 2>&1; then
		add_check "Проверка через SOCKS" 1 "https://ya.ru доступен через 127.0.0.1:1080"
	else
		proxy_detail="$(tail -n 1 /tmp/byedpi-luci-curl.log 2>/dev/null)"
		add_check "Проверка через SOCKS" 0 "${proxy_detail:-curl завершился с ошибкой}"
	fi

	podkop_proxy="$(uci -q get podkop.byedpi.proxy_string || true)"
	podkop_resolve="$(uci -q get podkop.byedpi.resolve_real_ip_for_routing || true)"
	if [ "$podkop_proxy" = "socks5://127.0.0.1:1080#byedpi" ]; then
		add_check "Podkop секция byedpi" 1 "$podkop_proxy"
	else
		add_check "Podkop секция byedpi" 0 "${podkop_proxy:-секция не найдена}"
	fi

	if [ "$podkop_resolve" = "1" ]; then
		add_check "Podkop resolve real IP" 1 "enabled"
	else
		add_check "Podkop resolve real IP" 0 "disabled"
	fi

	json_close_array
	json_dump
}

# Serialize service changes with test startup and installation, including other tabs.
lock_service_change() {
    local lock=/tmp/byedpi-luci-test-v2.start
    [ ! -x /usr/libexec/byedpi-luci-test ] || /usr/libexec/byedpi-luci-test status >/dev/null 2>&1
    mkdir "$lock" 2>/dev/null || { echo "Другая операция уже выполняется" >&2; return 1; }
    trap 'rmdir /tmp/byedpi-luci-test-v2.start 2>/dev/null || true' 0
    if [ "$(cat /tmp/byedpi-luci-test-v2/state 2>/dev/null)" = running ]; then
        echo "Сначала остановите подбор стратегии" >&2
        return 1
    fi
}

wait_service_state() {
    local wanted="$1" tries=0 running=0 consecutive=0
    while [ "$tries" -lt 8 ]; do
        sleep 1
        running=0
        /etc/init.d/byedpi status >/dev/null 2>&1 && running=1
        if [ "$running" = "$wanted" ]; then
            consecutive=$((consecutive + 1))
            [ "$consecutive" -lt 2 ] || return 0
        else
            consecutive=0
        fi
        tries=$((tries + 1))
    done
    return 1
}

service_action() (
    local action="$1" wanted=1
    case "$action" in start|stop|restart) ;; *) echo "Unsupported service action" >&2; return 1 ;; esac
    lock_service_change || return 1
    [ "$action" != stop ] || wanted=0
    /etc/init.d/byedpi "$action" >&2 && wait_service_state "$wanted" || {
        echo "ByeDPI не перешёл в ожидаемое состояние. Проверьте диагностику." >&2
        return 1
    }
    json_status
)

apply_strategy() (
    local strategy="$1" enabled="$2" backup was_enabled=0 was_running=0 ok=0 restored=1
    [ -n "$strategy" ] || { echo "Strategy is empty" >&2; return 1; }
    [ "$enabled" = 0 ] || enabled=1
    lock_service_change || return 1
    [ -z "$(uci changes byedpi)" ] || { echo "Сначала сохраните или отмените несохранённые изменения ByeDPI" >&2; return 1; }
    [ -f /etc/config/byedpi ] || { echo "Конфигурация ByeDPI отсутствует" >&2; return 1; }
    umask 077
    backup="$(mktemp /tmp/byedpi-apply.XXXXXX)" || return 1
    trap 'rm -f "$backup"; rmdir /tmp/byedpi-luci-test-v2.start 2>/dev/null || true' 0
    cp -p /etc/config/byedpi "$backup" || return 1
    /etc/init.d/byedpi enabled >/dev/null 2>&1 && was_enabled=1
    /etc/init.d/byedpi status >/dev/null 2>&1 && was_running=1
    if uci set byedpi.main.enabled="$enabled" &&
       uci set byedpi.main.cmd_opts="$strategy" &&
       uci set byedpi.main.options="$strategy" && uci commit byedpi; then
        if [ "$enabled" = 1 ]; then
            /etc/init.d/byedpi enable >&2 && /etc/init.d/byedpi restart >&2 && wait_service_state 1 && ok=1
        else
            /etc/init.d/byedpi disable >&2 && /etc/init.d/byedpi stop >&2 && wait_service_state 0 && ok=1
        fi
    fi
    if [ "$ok" = 1 ]; then json_status; return; fi
    cp -p "$backup" /etc/config/byedpi || restored=0
    uci -q revert byedpi || restored=0
    if [ "$was_enabled" = 1 ]; then
        /etc/init.d/byedpi enable >&2 || restored=0
    else
        /etc/init.d/byedpi disable >&2 || restored=0
    fi
    if [ "$was_running" = 1 ]; then
        /etc/init.d/byedpi restart >&2 && wait_service_state 1 || restored=0
    else
        /etc/init.d/byedpi stop >&2 && wait_service_state 0 || restored=0
    fi
    if [ "$restored" = 1 ]; then
        echo "Не удалось применить стратегию. Прежняя конфигурация и состояние службы восстановлены." >&2
    else
        echo "Не удалось применить стратегию; возврат требует проверки. Откройте диагностику ByeDPI." >&2
    fi
    return 1
)

case "$1" in
	status)
		json_status
		;;
	list-strategies)
		list_strategies
		;;
	diagnostics)
		diagnostics
		;;
	service)
		service_action "$2"
		;;
	apply)
		apply_strategy "$2" "$3"
		;;
	start-autotest)
		exec /usr/libexec/byedpi-luci-test start auto "$2" "$3"
		;;
	start-test|test-strategy)
		exec /usr/libexec/byedpi-luci-test start single "$2" 5
		;;
	test-status)
		exec /usr/libexec/byedpi-luci-test status
		;;
	stop-test)
		exec /usr/libexec/byedpi-luci-test stop
		;;
	*)
		echo "Usage: $HELPER_NAME status|list-strategies|diagnostics|service <start|stop|restart>|apply <strategy> <enabled>|start-autotest <strategy> <5|15|60>|start-test <strategy>|test-status|stop-test" >&2
		exit 1
		;;
esac
